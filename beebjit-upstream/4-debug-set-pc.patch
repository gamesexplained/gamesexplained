From 50737b4ef187f88992e4ac9ad1abdbee7ce3044c Mon Sep 17 00:00:00 2001
From: Aaron Bell <18724+air@users.noreply.github.com>
Date: Tue, 13 Oct 2026 13:40:57 +0000
Subject: [PATCH] Fetch the opcode again after the debugger, in case it changed
 PC.

The interpreter fetches the next opcode before the debug callout, so
setting PC from the debugger ran the opcode from the old PC with the
operands at the new one. A debugger write to the memory at PC was
missed the same way.

inturbo and JIT modes also mishandle a PC set from the debugger:
inturbo runs the old opcode as the interpreter did, and the JIT
carries on at the old PC. Both return through asm_debug, which has
a TODO for this; they are not changed here.

Adds a functional test that sets PC at the RESET entry and steps.

Co-Authored-By: Claude Opus 5.5 (1M context) <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01XRGcjre6t11Lj84xau655i
---
 interp.c                | 4 ++++
 run_functional_tests.sh | 7 +++++++
 2 files changed, 11 insertions(+)

diff --git a/interp.c b/interp.c
index 39d446a..5f1e901 100644
--- a/interp.c
+++ b/interp.c
@@ -3038,6 +3038,10 @@ check_irq:
                            do_irq);
       /* A debug command might have changed state that affected countdown. */
       countdown = timing_get_countdown(p_timing);
+      /* Or it might have changed PC, or the memory at PC. */
+      if (!do_irq) {
+        opcode = p_mem_read[pc];
+      }
     }
   }
 
diff --git a/run_functional_tests.sh b/run_functional_tests.sh
index d1913c8..43d5a2f 100755
--- a/run_functional_tests.sh
+++ b/run_functional_tests.sh
@@ -18,6 +18,13 @@ echo 'Checking E00 DFS ROM in sideways RAM.'
     -autoboot \
     -commands 'b 1900;c;q'
 
+echo 'Checking debugger PC change.'
+# This stops at the RESET entry, a 2 byte LDA #, points PC at a NOP at $2000
+# and steps once. The NOP must run, leaving PC at $2001.
+./beebjit -headless -debug -mode interp \
+    -commands "writem 2000 ea;eval pc=0x2000;s;eval '(pc==0x2001)||bail';q" \
+    > /dev/null
+
 echo 'Checking 6502 instruction timings (with cycle stretch).'
 # The test itself writes the number of failures to $FCD0, so breakpoint
 # expressions are used to trap and consider the write.
