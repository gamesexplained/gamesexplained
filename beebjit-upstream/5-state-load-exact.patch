   bbc_set_memory_block(p_bbc, 0, k_bbc_ram_size, p_bem->ram);
 
@@ -211,7 +283,7 @@ state_load(struct bbc_struct* p_bbc, const char* p_file_name) {
                     p_bem->sysvia_ifr,
                     p_bem->sysvia_ier,
                     0,
-                    p_bem->sysvia_IC32,
+                    0xFF,
                     p_bem->sysvia_t1c,
                     p_bem->sysvia_t1l,
                     p_bem->sysvia_t2c,
@@ -232,7 +304,7 @@ state_load(struct bbc_struct* p_bbc, const char* p_file_name) {
                     p_bem->uservia_ifr,
