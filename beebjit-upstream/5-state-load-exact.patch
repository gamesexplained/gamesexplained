diff --git a/state.c b/state.c
index 7a99432..0a1c86a 100644
--- a/state.c
+++ b/state.c
@@ -1,19 +1,25 @@
 #include "state.h"
 
+#include "adc.h"
 #include "bbc.h"
 #include "log.h"
+#include "mc6850.h"
+#include "serial_ula.h"
 #include "sound.h"
 #include "state_6502.h"
