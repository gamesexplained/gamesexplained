+    // the entry of memoryMapTable[] that the read_memory_*() functions use
+    unsigned int  n = (addr < 0x1000 ? 4U : addr < 0x8000 ? (unsigned int) (addr >> 14)
+                       : addr < 0xC000 ? 2U : addr < 0xFC00 ? 3U
+                       : addr < 0xFD00 ? 5U : addr < 0xFF00 ? 6U : 7U);
+    // segments from 0x80 up are RAM, below are ROM (getSegmentType())
+    return (memoryMapTable[cpuMemoryReadMap + n] >= 0x80);
+  }
