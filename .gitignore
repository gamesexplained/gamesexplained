*.scl
*.adf

# Local tool paths
.tools.env

# Editor and OS noise
.DS_Store
*.swp
__pycache__/
*.pyc
*.log

# Build output
_site/

# Locally installed tools (emulator build, disassembler binary, their state)
tools/
