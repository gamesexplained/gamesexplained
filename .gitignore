# Never commit game binaries or anything that embeds them.
games/*/*/work/*
!games/*/*/work/README.md
# a game of several parts keeps each part's snapshots beside it (kit/scripts/parts.py)
games/*/*/parts/*/work/*
!games/*/*/parts/*/work/README.md
*.d64
*.d71
*.d81
*.g64
*.prg
