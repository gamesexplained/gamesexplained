  {"image": "side-b", "label": "track 6", "place": {"track": 6, "read": "by the game", "to": ["$B800", "$4000"]}, "bytes": 3072, "sha256": "565a4cdbee43993c2bc5e2ade56972adcca50619d8da40336730fb017bcfa8eb", "problem": "the game read 4 different runs of bytes to $4000: a sector that reads differently each time, or sectors read one over another", "answer": "data", "why": "the last eight sectors of the upside-down castle picture, then the four sectors the loader reads into page $40 and never uses: on this side one of them holds a piece of a patched DOS 3.3, code for DOS's page $B6 that counts the free sectors in the VTOC and prints FREE= and the count"},
  {"image": "side-b", "label": "track 17", "place": {"track": 17, "read": "by the game", "to": ["$A800", "$4F00"]}, "bytes": 13405, "sha256": "68f40e2d950e9d7223ffa0d1289b882a62ba74e12c8f03ebbe980a08932753d7", "problem": "the game read 5 different runs of bytes to $A800: a sector that reads differently each time, or sectors read one over another", "answer": "part", "part": "palace", "at": "$A800", "why": "the palace's third track; its last sector is damaged in this copy and never read the same as side A's in five readings, and the eleven before it are side A's byte for byte"},
  {"image": "side-b", "label": "track 18", "place": {"track": 18, "read": "by the game", "to": ["$B400", "$4F00"]}, "bytes": 22709, "sha256": "547c32deb2eab24ec398c3db79c4c2daf96a802e103611a4373bd11174b93848", "problem": "the game read 11 different runs of bytes to $B400: a sector that reads differently each time, or sectors read one over another", "answer": "part", "part": "palace", "at": "$B400", "why": "the palace's fourth track; its ninth sector is damaged in this copy, so the loader never got past it in eleven readings; the eight before it are side A's byte for byte"},
  {"image": "side-b", "label": "track 19", "place": {"track": 19, "read": "by the game", "to": ["$1000", "$4F00"]}, "bytes": 2304, "sha256": "90cf549028f26eb5a46d335b15d404ff5f246d7d263ddce324f265af981b48a0", "answer": "part", "part": "dungeon", "at": "$1000", "why": "the dungeon's first track; its sixth sector is damaged in this copy, so the loader never got past it; the five before it are side A's byte for byte"},
  {"image": "side-b", "label": "track 27", "place": {"track": 27, "read": "by the game", "to": ["$0800", "$6000"]}, "bytes": 3072, "sha256": "24a0ed2df1743dc161f6c9cda5c8ff10757e8b57170e3bd0b75f2c447ad28738", "answer": "part", "part": "engine", "at": "$0800", "why": "side A's track 27 but for 384 bytes: the two tables of the 192 screen rows' addresses ($0800-$097F, row_lo and row_hi) run bottom to top here, which is all that makes this side draw the game upside down"}
