   "type": "line",
   "text": "\"        PUSH BUTTON TO CONTINUE         \""
  },
  {
   "address": 20657,
   "type": "line",
   "text": "The score board's bytes for blank and dashes"
  },
  {
   "address": 20671,
   "type": "line",
   "text": "Where the four score digits go in the bitmap"
  },
  {
   "address": 20675,
   "type": "line",
   "text": "The score board's digits, left halves, 16 bytes each"
  },
  {
   "address": 20867,
   "type": "line",
   "text": "The digits' right halves"
  },
  {
   "address": 21059,
   "type": "line",
   "text": "Frames per pixel of rise or fall by distance from the apex"
  },
  {
   "address": 21122,
   "type": "line",
   "text": "How far X moves back at the push, by the frames turned on the hands before fire: $FF (one forward) at once, then $18 falling to 0"
  },
  {
   "address": 21133,
   "type": "line",
   "text": "The lowest Y the body may reach on the mat, by its angle, in the layout and tuck"
  },
  {
   "address": 21189,
   "type": "line",
   "text": "The same for the landing pose, facing one way"
  },
  {
   "address": 21217,
   "type": "line",
