 "comments": [
  {
   "address": 6496,
   "type": "line",
   "text": "Stores the requested resource index at $19B7. Resets video, sound, and colour state for loading, chooses KERNAL banking and then jumps to the transition code at $1520. This entry uses an A-to-memory save where the TO loader places the selector on the stack."
  },
  {
   "address": 6583,
   "type": "line",
   "text": "Stores the selector saved at the start of the AD loading path; $19EC doubles the value to read the filename and destination pairs."
  },
  {
   "address": 6584,
   "type": "line",
   "text": "Selects RAM under the chips and exchanges $55 pages starting at $2C00 and $8600. Restores the KERNAL and I/O mapping after the exchange."
  },
  {
   "address": 6636,
   "type": "line",
   "text": "Doubles the selector from $19B7, loads the destination operand pair from $1A31 and filename from $1A45, configures logical file and drive 8, then calls KERNAL LOAD and jumps to the exchange routine. This path returned to the title without taking TO's game-over screen routine in the live comparison."
  },
  {
   "address": 6705,
   "type": "line",
   "text": "Ten little-endian starting addresses copied into the LDX and LDY immediate operands of KERNAL LOAD."
  },
  {
   "address": 6725,
   "type": "line",
   "text": "Ten two-byte names. The two bytes at $1A59 hold the active name passed to SETNAM."
  }
 ]
