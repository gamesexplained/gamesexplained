 "comments": [
  {
   "address": 21837,
   "type": "line",
   "text": "Save A, X, Y and the CPU port. Select I/O with BASIC and KERNAL ROM banked out before reading the VIC interrupt register."
  },
  {
   "address": 21861,
   "type": "line",
   "text": "Increment the tick byte when this IRQ takes the non-VIC path and $02B7 is clear."
  },
  {
   "address": 21872,
   "type": "line",
   "text": "Write the interrupt flags just read from $D019 back to acknowledge the asserted VIC sources."
  },
  {
   "address": 22019,
   "type": "line",
   "text": "Restore Y, X and A from the stack, then return from the interrupt."
  },
  {
   "address": 22038,
   "type": "line",
   "text": "The hardware NMI vector points to this single RTI instruction."
  },
  {
   "address": 48404,
   "type": "line",
   "text": "Wait for $1B to differ from the value saved at $0268, then copy the new value before the first call of the update."
  }
 ]
