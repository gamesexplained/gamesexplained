  },
  {
   "address": 24384,
   "type": "line",
   "text": "Copies the picture's colours into colour memory, shows the bitmap from bank $4000, and waits about 25 seconds or until a joystick moves or fires, then returns to the loader."
  },
  {
   "address": 24454,
   "type": "line",
   "text": "The wait: 5 times 256 frames, each at line $FA, ended by any joystick bit."
  },
  {
   "address": 24486,
   "type": "line",
   "text": "Zero bytes after the code."
  },
  {
   "address": 24576,
   "type": "line",
   "text": "The picture's two colours for each cell, the screen memory of the bitmap."
  },
  {
   "address": 24832,
   "type": "line",
   "text": "The rest of the picture's screen colours."
  },
  {
   "address": 25600,
   "type": "line",
   "text": "The picture's third colour for each cell, copied into colour memory."
  },
  {
   "address": 25856,
   "type": "line",
   "text": "The second page of the colour memory's source."
  },
  {
   "address": 26112,
   "type": "line",
   "text": "The third page."
  },
  {
   "address": 26368,
   "type": "line",
   "text": "The last page."
  },
  {
   "address": 26624,
   "type": "line",
   "text": "Zero bytes, 6 kilobytes up to $7FFF."
  },
