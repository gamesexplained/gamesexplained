  {"image": "side1", "label": "track 1, sector 0", "place": {"track": 1, "sectors": [0, 0]}, "bytes": 256, "sha256": "c89ac7258e49425256a09c2ec1dfed2ff34a0002658b9ee441172ec44ed3e549", "also": ["side2"], "answer": "loader", "why": "A boot sector for the Commodore 128, on both sides: it opens with the C128 boot signature \"CBM\", which only a C128 looks for at power-on. A C64 never reads it."},
  {"image": "side1", "label": "track 19, sectors 0-18", "place": {"track": 19, "sectors": [0, 18]}, "bytes": 4864, "sha256": "e918ed331ff05c6f23b3e40048a20fd8955fab5991c4c3ff1f54d5c33f345fbd", "answer": "part", "part": "resident", "at": "$B800", "packed": true, "why": "Packed or scrambled (7.9 bits of information a byte): the boot reads it. The resident code ($0800-$08FF and $B800-$FFFF) is in no file on either side, and tracks 19 to 22 are the only data left on the disk, so the resident comes from here."},
  {"image": "side1", "label": "track 20, sectors 0-18", "place": {"track": 20, "sectors": [0, 18]}, "bytes": 4864, "sha256": "dcb7563d04a2adc2dc09299cb32ca481d9d2171ce192d1a4a36d84c4cd5fd5db", "answer": "part", "part": "resident", "at": "$B800", "packed": true, "why": "More of the packed boot data, 7.8 bits a byte; with tracks 19, 21 and 22 it is the only source the resident code can have."},
  {"image": "side1", "label": "track 21, sectors 0-18", "place": {"track": 21, "sectors": [0, 18]}, "bytes": 4864, "sha256": "52a2a317a303502ddb0a2dc93ad468a6b8fbcf6817baddf33414d1138653cb0d", "answer": "part", "part": "resident", "at": "$B800", "packed": true, "why": "More of the packed boot data, 7.8 bits a byte, the third of the four tracks the resident code must come from."},
  {"image": "side1", "label": "track 22, sectors 0-18", "place": {"track": 22, "sectors": [0, 18]}, "bytes": 4864, "sha256": "783db30aa547d8a2d277333ee8d77576744c62f07491542ef3c7c17407c155bb", "answer": "part", "part": "resident", "at": "$B800", "packed": true, "why": "The end of the packed boot data: thirteen packed sectors and six of zeros."},
  {"image": "side1", "label": "track 23, sectors 0-18", "place": {"track": 23, "sectors": [0, 18]}, "bytes": 4864, "sha256": "1730c2dbe10678fb0203beaac7c2ae6609435887a18169e3f1e51658f74e2175", "also": ["side1: track 24, sectors 0-18"], "answer": "unused", "why": "Every byte is zero (tracks 23 and 24 are the same), so the sectors hold nothing whether the boot reads them or not; only the disk map marks them used."},
